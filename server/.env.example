# Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Server
PORT=3000
NODE_ENV=development

# CORS — set to the frontend origin
# Development: http://localhost:5173 (Vite default)
# Production:  your CloudFront or custom domain
CORS_ORIGIN=http://localhost:5173

# Database — MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster> with your Atlas cluster details.
# Never commit real credentials to version control.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/airsafe?retryWrites=true&w=majority
